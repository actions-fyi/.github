{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset, extend with \"github>actions-fyi/.github\"",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":gitSignOff",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["157150467+octo-sts[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Merge non-major updates automatically once required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Actions are pinned by .github/workflows/actions.lock, so keep readable tags; reusable workflows and images are not in the lockfile and stay digest-pinned",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": false
    },
    {
      "description": "Major updates wait for a human",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
